# Only affects `vite dev`'s own proxy target for /api and /ws — defaults to
# http://localhost:5000 if unset. Never read by `vite build`; the built
# client always calls its own origin (proxied by the Vercel rewrite or the
# Cloudflare Worker, depending on target — see vercel.json / wrangler.jsonc).
DEV_API_PROXY_TARGET=

# Firebase Web App config — Firebase console → Project settings → Your apps.
# Used only for the Google sign-in popup (src/lib/firebase.ts); the resulting
# ID token is exchanged with the backend at POST /api/v1/auth/google.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Supabase project config — used only by the (currently unwired) waitlist
# table migration in supabase/migrations/.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
