# Response headers for Cloudflare, mirroring the `headers` block in vercel.json
# so the two deployments serve the same security posture.
#
# connect-src stays on 'self' because /api and /ws are proxied through this
# origin (worker/index.ts) rather than called cross-origin. The backend host is
# listed as well so a direct call still works if the proxy is ever bypassed.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://apis.google.com https://*.gstatic.com https://*.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://forgefy.onrender.com wss://forgefy.onrender.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://apis.google.com https://www.googleapis.com; frame-src 'self' https://accounts.google.com https://*.firebaseapp.com https://apis.google.com https://*.pages.dev https://appetize.io https://*.appetize.io https://snack.expo.dev; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# The service worker must never be cached, or clients pin an old build.
/sw.js
  Cache-Control: no-cache, max-age=0, must-revalidate

/icons/*
  Cache-Control: public, max-age=86400
